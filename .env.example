# Copy to .env; .env is gitignored. Load it with:
#   node --env-file=.env --experimental-strip-types examples/pay-a-bill.ts

# Partner key, sent as X-Access-Token. It decides the environment: the examples refuse to
# run unless validate() reports SANDBOX. Never ship the production key to a browser.
BILLPAY_API_KEY=

# Sandbox key for `npm run test:integration` (the suite skips without it).
BILLPAY_SANDBOX_KEY=

# Leave empty: the default https://api.oneclickdz.com serves both environments.
BILLPAY_BASE_URL=

# Sandbox scenario selectors used by the examples (see README, "Sandbox").
BILLPAY_AADL_CODELOC=1112223334
BILLPAY_SEAAL_CODE_CLIENT=100001
BILLPAY_SEAAL_CODE_CONTRAT=446563
