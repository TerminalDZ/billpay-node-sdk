# Copy to .env and edit. .env is gitignored and must never be committed.
#
# Nothing loads this file for you — Node reads it when you ask it to:
#   npm run build
#   node --env-file=.env --experimental-strip-types examples/pay-a-bill.ts
#
# The examples also run with no .env at all: each falls back to the published sandbox key
# below, which is the same one the documentation prints.

# Your partner key, sent as the X-Access-Token header.
#
# It is also what decides the environment. Sandbox and production answer on the same host,
# so the URL proves nothing and this key is the only thing standing between an example and
# a real charge — which is why every example reads validate().apiKey.type back and refuses
# to run unless it says SANDBOX. Keep the production key out of this file and out of any
# browser bundle; a key shipped to a front end is a key you have published.
BILLPAY_API_KEY=

# Leave empty. The SDK default, https://api.oneclickdz.com, serves both environments:
# there is no separate sandbox host, and nothing to switch when you go live. Set this only
# to point the examples at a mock or a recording proxy of your own.
BILLPAY_BASE_URL=

# The AADL housing file number used by examples/aadl-avis.ts: digits only, 6 to 20 of
# them, and the only identifier AADL accepts. The sandbox reads it as a scenario selector:
#
#   1112223334  a payable avis, 5400.00 DZD, with a full breakdown   (the default)
#   2223334445  the same thing at 12000.00 DZD, two unpaid periods folded in
#   3334445556  nothing due — READY with an empty bills[]
#   4445556667  409 BILL_ALREADY_PAID, raised by the discovery itself
BILLPAY_AADL_CODELOC=1112223334
