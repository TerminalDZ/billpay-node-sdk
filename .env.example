# Copy to .env and fill in. .env is gitignored and must never be committed.

# Your partner API key. Sent as the X-Access-Token header.
# Sandbox keys are issued alongside production keys — start with the sandbox one.
BILLPAY_API_KEY=

# Omit to use production (https://billapi.oneclickdz.com).
# Point at the local stack to run the integration suite:
#   BILLPAY_BASE_URL=http://localhost:3100
BILLPAY_BASE_URL=
